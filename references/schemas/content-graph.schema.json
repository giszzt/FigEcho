{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figecho.example/schemas/content-graph.schema.json",
  "title": "FigEcho Content Graph 2.0",
  "type": "object",
  "required": ["schema_version", "title", "nodes", "groups", "edges", "reading_order", "exact_text", "content_policy"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "source_text", "role", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "label": {"type": "string", "minLength": 1},
          "source_text": {"type": "string", "minLength": 1},
          "role": {"enum": ["hero", "primary", "secondary", "annotation"]},
          "group_id": {"type": ["string", "null"]},
          "details": {"type": "array", "items": {"type": "string"}},
          "required": {"type": "boolean"}
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "members", "semantic_role", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "label": {"type": "string"},
          "members": {"type": "array", "items": {"type": "string"}},
          "semantic_role": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "relation", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {"enum": ["sequence", "branch", "merge", "contains", "depends_on", "maps_to", "feedback", "compares_with", "annotates"]},
          "label": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "reading_order": {"type": "array", "items": {"type": "string"}},
    "exact_text": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "value", "required"],
        "properties": {
          "kind": {"enum": ["title", "label", "formula", "data", "caption"]},
          "value": {"type": "string", "minLength": 1},
          "owner_id": {"type": ["string", "null"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "content_policy": {
      "type": "object",
      "required": ["must_show", "may_summarize", "may_omit_from_canvas", "forbidden_inventions", "portable_exclusions"],
      "properties": {
        "must_show": {"type": "array", "items": {"type": "string"}},
        "may_summarize": {"type": "array", "items": {"type": "string"}},
        "may_omit_from_canvas": {"type": "array", "items": {"type": "string"}},
        "forbidden_inventions": {"type": "array", "items": {"type": "string"}},
        "portable_exclusions": {"type": "array", "items": {"type": "string", "minLength": 2}}
      }
    }
  }
}
