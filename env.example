# FigEcho 图像后端密钥配置模板
#
# 用法：复制本文件为同目录下的 `.env`，填入你有的密钥（有哪个填哪个）。
# 也可以只写一份共享文件 `~/.claude/image-backends.env`，让多个图像 skill 共用；
# 已有 figedit-v2/.env 的话本 skill 会自动复用，无需重复填写。
# 系统环境变量优先于文件。`.env` 已被 .gitignore 排除。

# ---- ListenHub OpenAPI（与 Labnana 同账号同密钥，lh_ 开头）----
# 文档：https://listenhub.ai/docs/zh/openapi/api-reference/image-generation
LISTENHUB_API_KEY=
# LISTENHUB_BASE_URL=https://api.marswave.ai/openapi
# GPT 型号链，前一个报 "is not available" 才换下一个；official 按 token 计价最贵
# FIGECHO_GPT_MODELS=gpt-image-2,gpt-image-2.5-flare,gpt-image-2-official
# 旧变量名仍然认：LABNANA_API_KEY / LABNANA_BASE_URL

# ---- OpenAI 官方 ----
OPENAI_API_KEY=
# FIGECHO_OPENAI_IMAGE_MODEL=gpt-image-2

# ---- Google Gemini 官方 ----
GEMINI_API_KEY=
# GOOGLE_API_KEY=
# FIGECHO_GEMINI_IMAGE_MODEL=gemini-3-pro-image

# ---- 高级选项 ----
# 强制指定后端，跳过自动顺序：
#   labnana-gpt-image-2 / labnana-nano-banana / openai-official / gemini-official / configured-command
# FIGECHO_IMAGE_BACKEND=
# 自定义命令适配器配置 JSON 路径：
# FIGECHO_IMAGE_CONFIG=
